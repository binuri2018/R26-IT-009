 # Copy to .env and fill in.

# OpenAI: chat, embeddings (if EMBEDDING_PROVIDER=openai), Whisper, and TTS.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# sentence-transformers (local) vs openai embeddings for FAISS ingest + queries
EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Local embedding model name (when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# If downloads still fail, dev-only (not for production):
# BINURI_DISABLE_SSL_VERIFY=1
# ... patches Python ssl + Hugging Face Hub httpx so model files can download.


# Local LLM via Ollama — used when OPENAI_API_KEY is empty (chat only; Whisper/TTS still need OpenAI).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=600

RESOURCE_DIR=Resource
DATA_DIR=data

# ── Knowledge Maps (Member 4) ────────────────────────────────────────────
# Local-first LLM for verification/repair/OCR/synthesis/YouTube tools.
M4_LLM_PROVIDER=ollama
M4_OLLAMA_MODEL=gemma4:cloud

# Optional Member 4 cloud fallback, used only when M4_LLM_PROVIDER=azure.
# Existing /api/ask, /api/transcribe, /api/tts continue to use direct OpenAI.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# YouTube Data API v3 (used by /api/m4/youtube-suggest)
YOUTUBE_API_KEY=

# Only these domains (or their subdomains) may decide a web-backed verdict.
M4_WEB_ALLOWED_DOMAINS=
M4_CONFIDENCE_MODEL_PATH=

M4_HYBRID_DENSE_K=20
M4_HYBRID_BM25_K=20
M4_HYBRID_FUSED_K=8
M4_HYBRID_FINAL_K=5
M4_RRF_K=60
M4_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
M4_RERANKER_REVISION=
M4_QUERY_GLOSSARY_PATH=
M4_RETRIEVAL_POLICY_PATH=

M4_OCR_GLOSSARY_PATH=
M4_OCR_MAX_DIMENSION=2400
M4_OCR_CONFIDENCE_LOW=0.65
M4_OCR_CONFIDENCE_HIGH=0.85

M4_VERIFY_MAX_WORKERS=5
M4_WEB_SEARCH_TIMEOUT_SECONDS=8.0

# ── Adaptive Quiz component ─────────────────────────────────────────────
# MongoDB connection string (database name included in the URI). Leave empty
# to keep the Adaptive Quiz component dormant — the rest of the app is unaffected.
MONGO_URI=
# Secret used to sign student JWTs. Set a long random value in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
# Shared secret for the teacher dashboard (PDF question generator, class reports).
TEACHER_KEY=12345678
# ML micro-service (learning-state prediction + T5 PDF question generation).
ML_SERVICE_URL=http://127.0.0.1:8001
# Optional webcam/ML tuning:
# EMOTION_MODEL_PATH=backend/model/best.pt
# QUIZ_MODEL_PATH=backend/components/adaptive_quiz/models/learning_state_model.pkl
# EMOTION_YOLO_CONF=0.12
