# Fine-tuned Narrative Learning story writer (QLoRA on gemma-3-4b-it).
# Build:  ollama create narrative-gemma3 -f scripts/narrative_lora.Modelfile
# Use:    OLLAMA_LLM_MODEL=narrative-gemma3 in .env
FROM ./narrative-gemma3-4b.Q4_K_M.gguf

TEMPLATE """{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if or (eq .Role "user") (eq .Role "system") }}<start_of_turn>user
{{ .Content }}<end_of_turn>
{{ if $last }}<start_of_turn>model
{{ end }}
{{- else if eq .Role "assistant" }}<start_of_turn>model
{{ .Content }}{{ if not $last }}<end_of_turn>
{{ end }}
{{- end }}
{{- end }}"""

PARAMETER stop <end_of_turn>
PARAMETER temperature 0.65
PARAMETER top_k 64
PARAMETER top_p 0.95
PARAMETER num_ctx 6144
